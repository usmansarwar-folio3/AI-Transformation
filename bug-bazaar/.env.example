# Public client config only. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api

# Start the MSW mock API outside Vite DEV (e.g. Vercel Production).
# Prefer BUGBAZAR_ENABLE_MOCKS on Vercel (avoids the VITE_* browser-exposure warning).
# Also enables the in-browser live-stock poller (static hosts cannot run the Vite /stock WS).
# BUGBAZAR_ENABLE_MOCKS=true

# Optional: external WebSocket for live stock (otherwise DEV uses same-origin /stock;
# production with mocks uses the poller). Do NOT set this on Vercel unless you host a WS.
# VITE_STOCK_WS_URL=wss://example.com/stock
